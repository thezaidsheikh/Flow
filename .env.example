# Application Configuration
APP_PORT=3002

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/flow
DB_USERNAME=flow
DB_PASSWORD=flow

# JWT
JWT_SECRET=replace-with-a-32-byte-secret-at-minimum
JWT_EXPIRATION=3600000

# Optional credential encryption override.
# If omitted, the application derives the encryption key from JWT_SECRET.
ENCRYPTION_KEY=replace-with-a-separate-secret-if-desired
